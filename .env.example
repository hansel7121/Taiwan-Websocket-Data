# KGI credentials are stored app-encrypted in Supabase (public.credentials) and
# pulled at runtime, not read from env vars directly. See kgi_config.py and
# credential_store.py. CRYPTO_KEY must match the key used to upsert the row
# for KGI_ACCOUNT_LABEL (see scripts/upsert_credential.py) — share it out of
# band (not chat, not git), never commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CRYPTO_KEY=your_shared_fernet_key
KGI_ACCOUNT_LABEL=your_account_label

FINMIND_TOKEN=your_finmind_api_token