# KGI credentials are stored app-encrypted in Supabase (public.credentials) and
# pulled at runtime by default. See kgi_config.py and credential_store.py.
# CRYPTO_KEY must match the key used to upsert the row for KGI_ACCOUNT_LABEL
# (see scripts/upsert_credential.py) — share it out of band (not chat, not
# git), never commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CRYPTO_KEY=your_shared_fernet_key
KGI_ACCOUNT_LABEL=your_account_label

# Local fallback: set these instead to bypass Supabase entirely and read KGI
# credentials straight from this file (kgi_config.py checks KGI_TOKEN first).
# KGI_USER_ID=your_kgi_user_id
# KGI_PASSWORD=your_kgi_password
# KGI_TOKEN=your_quotecom_api_token
# KGI_SID=API
# KGI_BROKER_ID=your_broker_id
# KGI_ACCOUNT=your_account_number

FINMIND_TOKEN=your_finmind_api_token