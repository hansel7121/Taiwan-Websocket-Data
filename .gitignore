CLAUDE.md

# Secrets - real credentials live only in .env (see .env.example for the template)
.env

# Python build artifacts
__pycache__/
*.pyc
*.pyo

# Runtime/debug logs
*.log
QuoteComExamplePy/Logs/

# Ephemeral collector liveness signals (heartbeat/done-marker) — pure
# operational noise for the supervisor, not data. The depth/trades CSVs and
# state JSON in data/ are the real record and stay tracked.
data/*_heartbeat.txt
data/*.marker

# Word lock files
~$*
